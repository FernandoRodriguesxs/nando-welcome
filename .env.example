# Resend (https://resend.com) - contact form delivery. Copy to .env.local and fill in.
RESEND_API_KEY=

# Optional: where messages arrive (defaults to the address in src/lib/site.ts).
CONTACT_TO_EMAIL=

# Optional: sender. Without a verified domain, Resend only allows onboarding@resend.dev,
# which can deliver only to the e-mail of your Resend account.
CONTACT_FROM_EMAIL=
